            var elements = document.querySelectorAll(".barcode");
            elements.forEach(function(el) {
                var code = el.getAttribute("data-code");
                if (code) {
                    JsBarcode(el, code, {
                        format: "CODE128",
                        displayValue: true,    // Hiển thị chữ bên dưới
                        fontSize: 18,          // TĂNG KÍCH THƯỚC CHỮ (mặc định là 12, bạn tăng lên 18-20 tùy ý)
                        fontOptions: "bold",   // Bôi đậm chữ cho dễ đọc
                        textMargin: 4,         // Khoảng cách giữa vạch và chữ
                        height: 60,            // Tăng độ cao của các sọc mã vạch
                        width: 2,              // Độ rộng của từng vạch
                        margin: 0,
                        marginTop: 5
                    });
